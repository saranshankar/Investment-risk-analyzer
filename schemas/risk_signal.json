{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RiskSignal",
  "type": "object",
  "properties": {
    "rule_id": { "type": "string" },
    "category": { "type": "string", "enum": ["regulatory", "financial", "psychological", "identity", "payment", "communication"] },
    "severity": { "type": "string", "enum": ["low", "medium", "high"] },
    "triggered": { "type": "boolean" },
    "evidence_text": { "type": "string" },
    "score_contribution": { "type": "integer" }
  },
  "required": ["rule_id", "category", "severity", "triggered", "evidence_text", "score_contribution"]
}
