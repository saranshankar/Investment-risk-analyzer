# ==============================================================================
# TipCheck Environment Configuration (Template)
# ==============================================================================
# Copy this file to .env and fill in your values if configuring external services.
# TipCheck runs 100% locally out-of-the-box in deterministic mode without AWS credentials.

# --- Security & Network Settings ---
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# API rate limiting (requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60

# Server port configuration
PORT=8000

# --- Optional AWS Production Integration ---
# Leave blank to use local deterministic engine and local registry snapshot.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Optional: Amazon Bedrock Model ID for Agentic LLM Extraction & Safety Validation
# BEDROCK_MODEL_ID_EXTRACTION=anthropic.claude-3-haiku-20240307-v1:0
# BEDROCK_MODEL_ID_EXPLANATION=anthropic.claude-3-sonnet-20240229-v1:0

# Optional: DynamoDB Table Names (if persisting analysis history to AWS)
# DYNAMODB_TABLE_ANALYSIS_REQUESTS=TipCheck-AnalysisRequests
# DYNAMODB_TABLE_REGISTRY_CACHE=TipCheck-RegistryCache
